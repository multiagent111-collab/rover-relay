# Copy to .env. Node loads it at startup. No credentials needed in sample mode.
SAMPLE_MODE=true
DEMO_MODE=true
HOST=127.0.0.1
PORT=4173
DATA_DIR=.data
# Optional PostgreSQL; sample mode uses SQLite when this is blank.
DATABASE_URL=
PLAN_TTL_SECONDS=60
# Live sponsor mode requires both a server access token and real sponsor settings.
RELAY_ACCESS_TOKEN=
# Explicit choice: nightshift (default), or nvidia (direct development route).
# Direct mode is reported as nvidia-direct; it is not Nightshift verification.
RELAY_INFERENCE_PROVIDER=nightshift
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_ROUTE=
# Label to correlate with the model actually used in Nightshift receipts.
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Only used for RELAY_INFERENCE_PROVIDER=nvidia. Never sent to Nightshift or the UI.
NVIDIA_API_KEY=
ZETARIS_REST_URL=http://127.0.0.1:8888/api/v1.0
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_CANDIDATE_VIEW=relay_candidates
ZETARIS_ROUTE_VIEW=relay_route_edges
