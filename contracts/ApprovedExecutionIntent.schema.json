{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0"
    },
    "intentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "taskId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "missionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "request": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "number",
          "const": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["revision", "digest"],
      "additionalProperties": false
    },
    "approvedPlan": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["version", "digest"],
      "additionalProperties": false
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "executionBackend": {
      "type": "string",
      "enum": ["simulator", "http_gateway"]
    },
    "selected": {
      "type": "object",
      "properties": {
        "supplierId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
        },
        "courierId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
        }
      },
      "required": ["supplierId", "courierId"],
      "additionalProperties": false
    },
    "equipment": {
      "type": "object",
      "properties": {
        "sku": {
          "type": "string",
          "const": "HDMI-USB-C"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": ["sku", "quantity"],
      "additionalProperties": false
    },
    "pickup": {
      "type": "object",
      "properties": {
        "locationId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$"
        }
      },
      "required": ["locationId"],
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "properties": {
        "locationId": {
          "type": "string",
          "enum": ["auditorium", "library"]
        },
        "entrance": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 2,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["locationId", "entrance"],
      "additionalProperties": false
    },
    "money": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "const": "USD"
        },
        "itemEstimateCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "deliveryEstimateCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "explicitFeesCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "approvedTotalCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "currency",
        "itemEstimateCents",
        "deliveryEstimateCents",
        "explicitFeesCents",
        "approvedTotalCents"
      ],
      "additionalProperties": false
    },
    "absoluteDeadlineAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "memoryRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceIds": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "contractVersion",
    "intentId",
    "taskId",
    "missionId",
    "request",
    "approvedPlan",
    "approvedAt",
    "expiresAt",
    "executionBackend",
    "selected",
    "equipment",
    "pickup",
    "destination",
    "money",
    "absoluteDeadlineAt",
    "sourceFingerprint",
    "memoryRevision",
    "evidenceIds"
  ],
  "additionalProperties": false
}
