{
  "openapi": "3.1.0",
  "info": {
    "title": "Relay execution gateway contract",
    "version": "1.0",
    "description": "Proposed public contract, exercised only by controlled fixtures. These internal routes are NOT served by the Relay app. Requires separately verified identity and trusted stored approval; digest is not authorization. No production gateway activation."
  },
  "security": [
    {
      "VerifiedInternalAssertion": []
    }
  ],
  "paths": {
    "/internal/relay/v1/execution-intents": {
      "post": {
        "summary": "Verify owner and exact trusted approval; replay before expiry check; atomically reserve selected provider and persist one job/outbox",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovedExecutionIntent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative task; request does not imply provider acceptance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionTaskState"
                }
              }
            }
          },
          "400": {
            "description": "Typed conflict. Definitive new-intent conflicts guarantee no job was committed; unknown outcomes use 503 and retain the same intent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionConflict"
                }
              }
            }
          },
          "401": {
            "description": "Typed conflict. Definitive new-intent conflicts guarantee no job was committed; unknown outcomes use 503 and retain the same intent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionConflict"
                }
              }
            }
          },
          "409": {
            "description": "Typed conflict. Definitive new-intent conflicts guarantee no job was committed; unknown outcomes use 503 and retain the same intent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionConflict"
                }
              }
            }
          },
          "503": {
            "description": "Typed conflict. Definitive new-intent conflicts guarantee no job was committed; unknown outcomes use 503 and retain the same intent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionConflict"
                }
              }
            }
          }
        }
      }
    },
    "/internal/relay/v1/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Read the verified owner's authoritative execution mapping",
        "responses": {
          "200": {
            "description": "Authoritative task; request does not imply provider acceptance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionTaskState"
                }
              }
            }
          },
          "401": {
            "description": "Typed conflict. Definitive new-intent conflicts guarantee no job was committed; unknown outcomes use 503 and retain the same intent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionConflict"
                }
              }
            }
          },
          "409": {
