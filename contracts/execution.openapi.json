            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionConflict"
                }
              }
            }
          }
        }
      }
    },
    "/internal/relay/v1/tasks/{id}/cancel": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "summary": "Stable idempotent cancellation request; cancel_requested retains capacity until confirmed",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecutionCancel"
              }
            }
