      "VerifiedInternalAssertion": {
        "type": "http",
        "scheme": "bearer",
        "description": "Short-lived signed assertion binding verified tenant/subject, method/path, body digest, expiry and replay ID. Demo tokens/unsigned identity headers are invalid. Fixture-only HMAC protocol is not a production credential deployment."
      }
    },
